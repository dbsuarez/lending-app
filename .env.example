# Public client settings only. Never place a Supabase service-role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
APP_ENV=development
# Optional local-only convenience. Never use these in a deployed web build.
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=
# Deployed web origin used when generating customer links, without a trailing slash.
PUBLIC_APP_URL=
# Deployed web origin used when generating customer links, without a trailing slash.
PUBLIC_APP_URL=
# Optional local-only convenience. Never use these in a deployed web build.
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=
