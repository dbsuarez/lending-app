{
  "hosting": {
    "target": "production",
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/s/**", "destination": "/status.html" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "/@(assets|canvaskit|icons)/**",
        "headers": [
          { "key": "Cache-Control", "value": "public,no-cache" }
        ]
      },
      {
        "source": "/@(index.html|status.html|main.dart.js|flutter_bootstrap.js|flutter_service_worker.js|version.json|app_build.json)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache,no-store,must-revalidate" }
        ]
      }
    ]
  }
}
